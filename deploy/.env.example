# Copy to deploy/.env on the VM (git-ignored) and fill in. Generate secrets with:
#   openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=

# First start only: creates the Super Admin if none exists. Remove the PIN after the first login.
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PIN=

# Optional for backup.sh: copy each dump to S3 (needs aws cli + an instance role).
# BACKUP_S3=s3://your-bucket/naanayam
